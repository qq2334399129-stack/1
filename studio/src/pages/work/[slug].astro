---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Video from '../../components/Video.astro';
import { projects } from '../../data/projects';
import { media } from '../../utils/media';
export function getStaticPaths() { return projects.map(project => ({ params:{ slug:project.slug }, props:{ project } })); }
const { project } = Astro.props;
const related = projects.filter(p => p.slug !== project.slug).sort((a,b) =>
  Number(b.category === project.category) - Number(a.category === project.category) ||
  b.tags.filter(tag => project.tags.includes(tag)).length - a.tags.filter(tag => project.tags.includes(tag)).length).slice(0,2);
---
<Base title={project.title} description={project.description} image={media(project.cover)} dark structured={{'@type':'CreativeWork', name:project.title, image:new URL(media(project.cover), Astro.site).href, genre:project.category}}>
  <section class="shell page-heading detail-heading">
    <a class="text-link" href="/work/">全部作品</a>
    <p class="eyebrow">{project.category} / 概念样稿 / {project.year}</p><h1>{project.title}</h1><p>{project.description}</p>
    <div class="detail-media card-image"><Cover path={project.cover} alt={project.alt} priority />{project.video && <Video source={project.video} poster={project.cover} title={project.title} />}</div>
  </section>
  <section class="shell section detail-copy">
    <div><h2>项目背景</h2><p>{project.description} 此处呈现概念探索与制作练习。</p><h2>创作思路</h2><p>{project.concept}</p></div>
    <div><h2>制作流程</h2><ol>{project.process.map(step => <li>{step}</li>)}</ol><h2>使用技术</h2><p>{project.tools.join(' · ')}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
  </section>
  <section class="shell section"><div class="section-heading"><h2>相关作品</h2></div><div class="work-grid">{related.map(item => <ProjectCard project={item} />)}</div></section>
</Base>
