---
import Base from '../../layouts/Base.astro';
import JournalCard from '../../components/JournalCard.astro';
import Filters from '../../components/Filters.astro';
import { journal } from '../../utils/journal';
const entries = await journal();
const categories = ['AI 视频技术','AI 创作经验','商业视频制作','AIGC 行业观察','创作教程'];
const values = [...new Set([...categories, ...entries.flatMap(e => [e.data.category, ...e.data.tags])])];
---
<Base title="创作日志" description="有关 AI 视频技术、商业影像、创作经验和 AIGC 实践的日志。" image="/images/object.webp">
  <section class="shell page-heading"><p class="eyebrow">JOURNAL</p><h1>创作日志</h1><p>关于 AI 影像、视觉叙事与制作流程的记录。</p><a class="text-link" href="/rss.xml">订阅 RSS</a></section>
  <section class="shell listing" aria-label="文章列表">
    <Filters values={values} all="全部文章" label="按分类或标签筛选文章" />
    <div class="journal-grid">{entries.map(entry => <div data-filter-item data-category={entry.data.category} data-tags={entry.data.tags.join('|')}><JournalCard entry={entry} /></div>)}</div>
  </section>
</Base>
