---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import ProjectCard from '../components/ProjectCard.astro';
import JournalCard from '../components/JournalCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { services } from '../data/services';
import { journal } from '../utils/journal';
const featured = projects.filter(p => p.featured).slice(0,6);
const latest = (await journal()).slice(0,3);
---
<Base title="首页">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow hero-label"><span></span> {site.chineseName} <span class="label-divider"></span> INDEPENDENT CREATIVE STUDIO</p>
      <h1>让想象，<br/><em>有画面。</em></h1>
      <p class="hero-description">{site.introduction}</p>
      <div class="actions"><a class="button solid" href="/work/">查看作品 <span aria-hidden="true">↗</span></a><a class="button outline" href="/contact/">联系合作</a></div>
    </div>
    <figure class="hero-figure">
      <div class="hero-image"><Cover path={projects[0].cover} alt={projects[0].alt} priority /></div>
      <figcaption><span>寂静之门 / 电影感场景练习</span><a href="/work/silent-monument/">查看项目 <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
  </section>
  <section class="shell section intro" data-reveal>
    <p class="eyebrow">ABOUT THE STUDIO</p>
    <div><h2>独立影像与视觉创作</h2><p>围绕 AI 影像、商业广告和视觉设计开展创作。从故事构思、分镜到画面制作，让每个镜头服务于同一个表达。</p><a class="text-link" href="/about/">了解创作方式</a></div>
  </section>
  <section class="shell section" aria-labelledby="featured">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="featured">精选作品</h2></div><a class="text-link" href="/work/">浏览全部作品</a></div>
    <div class="work-grid featured-grid">{featured.map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="services-band">
    <div class="shell section service-split">
      <div><p class="eyebrow">SERVICES</p><h2>为项目定制<br/>影像与视觉</h2><a class="text-link" href="/services/">了解服务</a></div>
      <div class="service-list">{services.map(service => <a href={`/services/#${service.id}`}><span>{service.title}</span><span aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>
  <section class="shell section philosophy" data-reveal>
    <div class="card-image"><Cover path="images/sphere.webp" alt="水面之上悬浮的透明球体" /></div>
    <div><p class="eyebrow">CREATIVE APPROACH</p><h2>先找到画面的情绪，<br/>再决定它的形式。</h2><p>同一个概念可以有许多种视觉解法。先确定希望观众感受到什么，再用光线、构图和节奏把它表达出来。</p></div>
  </section>
  <section class="shell section" aria-labelledby="latest">
    <div class="section-heading"><div><p class="eyebrow">JOURNAL</p><h2 id="latest">最新日志</h2></div><a class="text-link" href="/journal/">阅读全部日志</a></div>
    <div class="journal-grid">{latest.map(entry => <JournalCard entry={entry} />)}</div>
  </section>
  <ContactBand />
</Base>
