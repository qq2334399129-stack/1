---
import Cover from './Cover.astro';
import type { projects } from '../data/projects';
const { project } = Astro.props as { project: typeof projects[number] };
---
<article class="project-card" data-filter-item data-category={project.category} data-reveal>
  <a href={`/work/${project.slug}/`}>
    <div class="card-image"><Cover path={project.cover} alt={project.alt} /></div>
    <div class="card-info"><div><p class="meta">{project.category} <span>·</span> 概念样稿</p><h3>{project.title}</h3></div><span class="card-arrow" aria-hidden="true">↗</span></div>
    <p class="card-desc">{project.description}</p>
  </a>
</article>
